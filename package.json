    "check": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
