{
  "extends": "frappe-ui/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "*.ts",
    "*.mts",
    "../shared/design/*.ts",
    "../shared/components/**/*.ts",
    "../shared/components/**/*.vue"
  ]
}
