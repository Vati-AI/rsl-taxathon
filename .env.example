# Local synthetic development only; scripts/dev_env.py generates .env securely.
POSTGRES_PASSWORD=
JUBE_BASE_URL=
JUBE_API_KEY=
OPENALEPH_BASE_URL=
OPENALEPH_API_KEY=
YENTE_BASE_URL=
YENTE_DATASET=
DOCLING_BASE_URL=
DOCLING_API_KEY=
FRAPPE_BASE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
# Model credentials belong only in your ignored .env / approved secret store.
# ADR-031: mock is the default; set keys locally to enable live models. Synthetic data only.
# VATI_MODEL_PROVIDER: mock | hosted | local | template (see ai/README.md, TAX-089).
VATI_MODEL_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=
VATI_MODEL_REASONING=openai/gpt-oss-120b
VATI_MODEL_FAST=openai/gpt-oss-20b
# Document model ID pending team confirmation (gemini-2.5-flash is deprecated; see ADR-031).
VATI_MODEL_DOCUMENT=
OLLAMA_BASE_URL=
VATI_MODEL_LOCAL=
# Optional router budgets (TAX-089); defaults shown. Timeouts are clamped to 1-120 s.
VATI_MODEL_TIMEOUT_S=30
VATI_MODEL_MAX_CALLS=50
VATI_MODEL_MAX_OUTPUT_TOKENS=2048
VATI_MODEL_MAX_TOTAL_TOKENS=100000
VATI_MODEL_MAX_INPUT_CHARS=24000
POSTGRES_PORT=55433
REDIS_PORT=56380

FRAPPE_DB_PASSWORD=
